
# Backend API URL
VITE_API_URL=http://localhost:8000

# For production, update this to your deployed backend URL
# VITE_API_URL=https://your-backend.onrender.com

# OpenAI API Key (for LLM analysis feature)
# Get your API key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Alternative: You can also use other LLM providers:
# - Anthropic Claude: https://console.anthropic.com/
# - Google Gemini: https://ai.google.dev/
# - Or deploy your own backend with any LLM

# Note: For production, consider moving LLM calls to your backend
# to keep API keys secure and add rate limiting
